# Copy to Release.local.env and fill only the values needed by your destination.
# Release.local.env is ignored by Git.

APPLE_TEAM_ID=
QA_PROVISIONING_PROFILE_SPECIFIER=Camerae Ad Hoc
QA_SIGNING_CERTIFICATE=iPhone Distribution

# App Store Connect upload (API key file already stored locally).
APP_STORE_CONNECT_KEY_PATH=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=

# Firebase App Distribution. Defaults target the Camerae QA Firebase application.
# Override only for an intentional environment migration.
FIREBASE_APP_ID=1:413701042509:ios:74c9e8eb4ed40d45d20704
FIREBASE_PROJECT_ID=
FIREBASE_GROUPS=testers
# Every Firebase publication requires exactly one of these:
RELEASE_NOTES=
# RELEASE_NOTES_FILE=/absolute/path/to/firebase-release-notes.txt
# FIREBASE_TOKEN=
