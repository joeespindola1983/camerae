#include? "../Pods/Target Support Files/Pods-Camerae/Pods-Camerae.qa.xcconfig"
#include "Signing.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = com.espindola.camerae.qa
CAMERAE_DISPLAY_NAME = Camerae QA
GOOGLE_SERVICE_INFO_PLIST = $(SRCROOT)/Config/Firebase/QA/GoogleService-Info.plist
CAMERAE_CRASHLYTICS_COLLECTION_ENABLED = YES
CAMERAE_RELEASE_CHANNEL = qa
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = iPhone Distribution
PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*] = Camerae Ad Hoc
